#!/usr/bin/env php
<?php
error_reporting(E_ALL & ~E_DEPRECATED);
(static function (): void {
    // Composer >= 2.2 exposes the autoloader path to bin proxies.
    $candidates = [
        $GLOBALS['_composer_autoload_path'] ?? null,
        dirname(__DIR__) . '/vendor/autoload.php',       // standalone checkout / phar
        dirname(__DIR__, 3) . '/autoload.php',           // installed as vendor/<org>/regression
    ];
    foreach ($candidates as $file) {
        if ($file !== null && is_file($file)) {
            require $file;
            return;
        }
    }
    fwrite(STDERR, "Cannot find Composer autoloader. Run `composer install`.\n");
    exit(1);
})();

use Psr\Http\Message\RequestInterface;
use Psr\Http\Message\ResponseInterface;
use Regression\Helpers\Output\QueueOutput;
use Regression\Helpers\Output\RequestOutputItem;
use Regression\Helpers\Output\ResponseOutputItem;
use Regression\Config;
use Regression\Status;
use Symfony\Component\Console\Input\InputArgument;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\SingleCommandApplication;
use Symfony\Component\Console\Style\SymfonyStyle;

(new SingleCommandApplication())
    ->setName('Regression Testing') // Optional
    ->setVersion('0.2.7') // Optional
    ->addArgument('base_uri', InputArgument::REQUIRED, 'The base uri of your application')
    ->addOption('tests_dir', 'd', InputOption::VALUE_OPTIONAL, 'The directory where your tests are placed', './tests')
    ->addOption('type', 't', InputOption::VALUE_OPTIONAL, 'Type of the test: "assessment" or "regression". Default - both')
    ->addOption('test_files', 'f', InputOption::VALUE_OPTIONAL|InputOption::VALUE_IS_ARRAY, 'Path to the file with the test (separate multiple paths with a space)')
    ->addOption('debug', null, InputOption::VALUE_NONE, 'Show detailed info about requests and responses')
    ->addOption('trace', null, InputOption::VALUE_NONE, 'Add X-Test-Name Header with the Scenario class name as a value for each request')
    ->addOption('credentials', 'c', InputOption::VALUE_OPTIONAL|InputOption::VALUE_IS_ARRAY, 'Credentials. Colon-separated username+password')
    ->addOption('failed_scenarios', null, InputOption::VALUE_NONE, 'Show detailed info about requests and responses for failed tests')
    ->addOption('failed_steps', null, InputOption::VALUE_NONE, 'Show last request/response for failed tests')
    ->addOption('licenses', 'l', InputOption::VALUE_OPTIONAL|InputOption::VALUE_IS_ARRAY, 'Array of Sugar licences for which tests should be executed')
    ->addOption('parallel', 'p', InputOption::VALUE_REQUIRED, 'Run with N worker processes (requires `regression-platforms install -w N`)', '1')
    ->addOption('platform', null, InputOption::VALUE_REQUIRED, 'API platform for logins (set per worker by --parallel)', 'base')
    ->addOption('report-json', null, InputOption::VALUE_REQUIRED, 'Write machine-readable results to this file')
    ->addOption('skip-license-update', null, InputOption::VALUE_NONE, 'Assume the license is already applied (used by --parallel workers)')
    ->addOption('user-pool', null, InputOption::VALUE_REQUIRED | InputOption::VALUE_IS_ARRAY, 'Pre-provisioned users (user:password) used by createUser() when users cannot be created (IdM)')
    ->addOption('worker', null, InputOption::VALUE_REQUIRED, 'Worker index (set by --parallel)', '1')
    ->addOption('workers', null, InputOption::VALUE_REQUIRED, 'Number of workers (set by --parallel)', '1')
    ->addOption('timings', null, InputOption::VALUE_REQUIRED, 'Previous --report-json: run the longest scenarios first in --parallel mode')
    ->addOption('timeout', null, InputOption::VALUE_REQUIRED, 'HTTP request timeout in seconds', '120')
    ->addOption('serve', null, InputOption::VALUE_NONE, 'Worker mode: read scenario paths from stdin, write JSON results to stdout')
    ->addOption('keep-data', null, InputOption::VALUE_NONE, 'Do not run cleanups/tearDown (leave created data for debugging)')
    ->addOption('run-id', null, InputOption::VALUE_REQUIRED, 'Identifier used to tag data created by this run (default: random)')
    ->addOption('slowest', null, InputOption::VALUE_REQUIRED, 'Show N slowest scenarios', '10')
    ->setCode(function (InputInterface $input, OutputInterface $output) {
        $start = microtime(true);
        $type = $input->getOption('type');
        $testFiles = $input->getOption('test_files');
        if ($input->getOption('serve')) {
            $iterator = new ArrayObject([]); // scenarios arrive on stdin
        } elseif (!empty($testFiles)) {
            $iterator = new ArrayObject($testFiles);
        } else {
            if ($type !== null && !in_array(strtolower($type), ['regression', 'assessment'])) {
                throw new InvalidArgumentException("'type' can be only 'regression' or 'assessment', '{$type}' given");
            } else {
                $rx = $type === null ? '/^.+(Regression|Assessment)\.php$/' : "/^.+{$type}\.php$/i";
            }
            $customRecursiveIterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($input->getOption('tests_dir')));
            $iterator = new RegexIterator($customRecursiveIterator, $rx);
        }

        $licenses = $input->getOption('licenses') ?: [Config::DEFAULT_LICENSE];

        if ((int)$input->getOption('parallel') > 1) {
            $files = [];
            foreach ($iterator as $file) {
                $files[] = (string)$file;
            }
            sort($files);
            return (new \Regression\Runner\ParallelRunner($input, new SymfonyStyle($input, $output), __FILE__))
                ->run($files, $licenses, (int)$input->getOption('parallel'));
        }
        $configParams = [
            'baseUri' => $input->getArgument('base_uri'),
            'keepData' => (bool)$input->getOption('keep-data'),
            'runId' => $input->getOption('run-id'),
            'timeout' => (float)$input->getOption('timeout'),
            'platform' => $input->getOption('platform'),
            'worker' => (int)$input->getOption('worker'),
            'workers' => (int)$input->getOption('workers'),
            'userPool' => (function (array $pairs): array {
                $pool = [];
                foreach ($pairs as $pair) {
                    [$login, $password] = explode(':', $pair, 2) + [1 => ''];
                    $pool[$login] = $password;
                }
                return $pool;
            })($input->getOption('user-pool') ?: []),
            'licenseApplied' => (bool)$input->getOption('skip-license-update'),
        ];
        if ($credentials = $input->getOption('credentials')) {
            $loginPasswordPairs = [];
            foreach ($credentials as $credential) {
                [$login, $password] = explode(':', $credential, 2);
                $loginPasswordPairs[$login] = $password;
            }
            $configParams['credentials'] = $loginPasswordPairs;
        }

        $code = 0;

        foreach ($licenses as $license) {
            $testsCount = 0;
            $failed = 0;
            $success = 0;
            $skipped = 0;
            $regressions = [];
            $vulnerabilities = [];
            $cleanupErrors = [];
            $durations = [];

            $io = new SymfonyStyle($input, $output);
            if (!$input->getOption('serve')) {
                $io->title('Running Regression Tests for license ' . $license . '...');
            }
            $totalScenarios = iterator_count($iterator);
            $configParams['license'] = $license;
            $config = Config::create($configParams);

            $isDebug = $input->getOption('debug');
            $isFailedScenarios = $input->getOption('failed_scenarios');
            $isFailedSteps = $input->getOption('failed_steps');
            $executor = new \Regression\Runner\ScenarioExecutor($isDebug, $isFailedScenarios, $isFailedSteps, (bool)$input->getOption('trace'));

            if ($input->getOption('serve')) {
                // Parallel worker: read scenario paths from stdin, answer one JSON line per scenario.
                while (($line = fgets(STDIN)) !== false) {
                    $file = trim($line);
                    if ($file === '') {
                        continue;
                    }
                    $buffer = new \Symfony\Component\Console\Output\BufferedOutput($output->getVerbosity(), false);
                    $result = $executor->run($file, $config, new SymfonyStyle($input, $buffer));
                    $result['output'] = $buffer->fetch();
                    fwrite(STDOUT, json_encode($result, JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
                    fflush(STDOUT);
                }
                return 0;
            }

            $showProgress = false;
            if (!($isDebug || $isFailedScenarios || $isFailedSteps)) {
                $showProgress = true;
                $io->progressStart($totalScenarios);
            }

            $results = [];
            foreach ($iterator as $classFile) {
                $result = $executor->run((string)$classFile, $config, $io);
                if ($result['outcome'] === \Regression\Runner\ScenarioExecutor::MISSING) {
                    continue;
                }
                $results[] = $result;
                $testsCount++;
                $durations[$result['description']] = $result['duration'];
                array_push($cleanupErrors, ...$result['cleanupErrors']);
                match ($result['outcome']) {
                    'success' => $success++,
                    'skipped' => $skipped++,
                    'vulnerability' => [$failed++, $vulnerabilities[] = $result['message']],
                    'regression' => [$failed++, $regressions[] = $result['message']],
                    default => null, // risky: reported, not counted (historical behaviour)
                };
                $showProgress && $io->progressAdvance();
            }

            $showProgress && $io->progressFinish();
            $io->horizontalTable(['Total', 'Success', 'Issues', 'Skipped'], [
                [$testsCount, $success, $failed, $skipped]
            ]);
            if ($reportFile = $input->getOption('report-json')) {
                file_put_contents($reportFile, json_encode([
                    'license' => $license,
                    'total' => $testsCount,
                    'success' => $success,
                    'failed' => $failed,
                    'skipped' => $skipped,
                    'regressions' => $regressions,
                    'vulnerabilities' => $vulnerabilities,
                    'cleanupErrors' => $cleanupErrors,
                    'durations' => $durations,
                    'tests' => $results,
                ], JSON_PRETTY_PRINT | JSON_INVALID_UTF8_SUBSTITUTE));
            }
            if (!empty($cleanupErrors)) {
                $io->warning('Cleanup problems (data may be left on the instance; run ID ' . $config->getRunId() . ')');
                $io->listing($cleanupErrors);
            }
            $slowest = (int)$input->getOption('slowest');
            if ($slowest > 0 && !empty($durations)) {
                arsort($durations);
                $rows = [];
                foreach (array_slice($durations, 0, $slowest, true) as $name => $seconds) {
                    $rows[] = [sprintf('%.1fs', $seconds), mb_strimwidth($name, 0, 100, '...')];
                }
                $io->section("Slowest $slowest scenarios");
                $io->table(['Time', 'Scenario'], $rows);
            }
            if ($failed === 0) {
                $io->success('No issues found');
            }

            if (count($regressions)) {
                $io->error('Regression!');
                $io->listing($regressions);
                $code = 1;
            }
            if (count($vulnerabilities)) {
                $io->error('Possible vulnerabilities');
                $io->listing($vulnerabilities);
                $code = 1;
            }
        }

        $timeElapsedSecs = microtime(true) - $start;
        $io->info("Execution time: $timeElapsedSecs seconds.");

        $io->info('Memory consumed: ' . round(memory_get_usage() / 1024) . 'KB.');

        $io->info('Peak usage: ' . round(memory_get_peak_usage() / 1024) . 'KB.');

        return $code;
    })
    ->run();